# Comma-separated list of origins allowed to call the API from a browser.
TERRAMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default location for weather and the digital-twin workspace (Hyderabad).
TERRAMIND_DEFAULT_LATITUDE=17.3850
TERRAMIND_DEFAULT_LONGITUDE=78.4867

# Digital-twin data provider. Only "demo" (SIMULATED data) exists today.
TERRAMIND_TWIN_PROVIDER=demo

# Open-Meteo forecast endpoint (no API key required).
TERRAMIND_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
TERRAMIND_WEATHER_CACHE_SECONDS=300
