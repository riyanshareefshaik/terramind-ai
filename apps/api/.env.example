# Comma-separated list of origins allowed to call the API from a browser.
TERRAMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default location for weather and the digital-twin workspace (Vijayawada).
TERRAMIND_DEFAULT_LATITUDE=16.5062
TERRAMIND_DEFAULT_LONGITUDE=80.6480

# Open-Meteo forecast endpoint (no API key required).
TERRAMIND_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
TERRAMIND_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1/air-quality
TERRAMIND_WEATHER_CACHE_SECONDS=600

# Place search (OpenStreetMap Nominatim; max 1 request/second is enforced).
TERRAMIND_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Overpass endpoints for OSM building tiles, tried in order.
TERRAMIND_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter

# Where fetched building tiles are cached, and for how long.
# TERRAMIND_CACHE_DIR=/absolute/path  (default: <repo>/datasets/cache)
TERRAMIND_TILE_CACHE_DAYS=14
