# Copy to .env.local and fill in. Never commit .env.local.

# Cesium ion access token (https://ion.cesium.com/tokens). Enables Cesium World
# Terrain, Cesium OSM Buildings and Bing aerial imagery. Without it the
# workspace falls back to OpenStreetMap imagery on a smooth ellipsoid.
VITE_CESIUM_ION_TOKEN=

# Base URL of the TerraMind API. Leave empty to use the Vite dev proxy (/api).
VITE_API_BASE_URL=

# Where the Vite dev/preview proxy forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:8000

# Home view of the 3D workspace (defaults to Hyderabad).
VITE_HOME_LATITUDE=17.3850
VITE_HOME_LONGITUDE=78.4867
VITE_HOME_NAME=Hyderabad
