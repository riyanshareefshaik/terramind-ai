# Copy to .env.local if you want to change anything. Everything works without it.

# Optional Cesium ion token (https://ion.cesium.com/tokens). Upgrades terrain to
# Cesium World Terrain; without it, free terrain tiles are used.
VITE_CESIUM_ION_TOKEN=

# Base URL of the TerraMind API. Leave empty to use the Vite dev proxy (/api).
VITE_API_BASE_URL=

# Where the Vite dev/preview proxy forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:8000

# Home view (defaults to Vijayawada).
VITE_HOME_LATITUDE=16.5062
VITE_HOME_LONGITUDE=80.6480
VITE_HOME_NAME=Vijayawada
